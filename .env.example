# ─── Database: Neon PostgreSQL ───────────────────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct (non-pooled) connection — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ─── Authentication: Clerk ───────────────────────────────────────────
# Clerk Dashboard → Configure → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"
# Clerk Dashboard → Webhooks → endpoint signing secret (syncs users/invites to our DB)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_REPLACE_ME"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── App ─────────────────────────────────────────────────────────────
# Base URL used when building invitation links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
